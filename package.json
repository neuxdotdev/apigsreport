{
	"name": "apigsreport",
	"version": "1.1.1",
	"description": "pure javascript library to automate a ui job to full using SSRS server api",
	"author": {
		"name": "neuxdotdev",
		"email": "neuxdev1@gmail.com",
		"url": "https://github.com/neuxdotdev"
	},
	"contributors": [],
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"packageManager": "bun@1.3.12",
	"engines": {
		"node": ">=24",
		"bun": ">=1.3"
	},
	"main": "./build/lib.cjs",
	"module": "./build/lib.mjs",
	"types": "./build/lib.d.ts",
	"exports": {
		".": {
			"types": "./build/lib.d.ts",
			"import": "./build/lib.mjs",
			"require": "./build/lib.cjs",
			"default": "./build/lib.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"build",
		"readme.md",
		"license"
	],
	"keywords": [
		"ssrs",
		"sql-server-reporting-services",
		"ntlm-auth",
		"report-exporter",
		"pdf-export",
		"excel-export",
		"http-client",
		"web-automation",
		"session-management",
		"csrf-token",
		"cookie-persistence",
		"typescript",
		"bun",
		"nodejs",
		"libts",
		"enterprise-reporting",
		"paginated-reports",
		"reportserver-api"
	],
	"homepage": "https://github.com/neuxdotdev/apigsreport#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/neuxdotdev/apigsreport.git",
		"directory": "."
	},
	"bugs": {
		"url": "https://github.com/neuxdotdev/apigsreport/issues",
		"email": "neuxdev1@gmail.com"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/neuxdotdev"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"provenance": true
	},
	"os": [
		"linux",
		"darwin",
		"win32"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"scripts": {
		"dev": "rollup -c rollup.config.mjs -w",
		"dev:lib": "rollup -c rollup.config.mjs -w",
		"docs:clean": "rm -rf docs docs-md",
		"docs:generate": "typedoc",
		"docs:generate:md": "typedoc --plugin typedoc-plugin-markdown --out ./docs-md",
		"docs:serve": "npx http-server docs -p 8080 -o",
		"docs:watch": "typedoc --watch",
		"docs:coverage": "typedoc --coverageOutputPath ./docs/coverage.svg",
		"docs:full": "bun run docs:clean && bun run docs:generate && bun run docs:serve",
		"docs:all": "bun run docs:generate && bun run docs:generate:md",
		"docs:build": "typedoc && node scripts/fix-sidebar.mjs && vitepress build docs",
		"docs:dev": "typedoc && node scripts/fix-sidebar.mjs && vitepress dev docs",
		"docs:preview": "vitepress preview docs",
		"clean": "rm -rf build node_modules/.cache",
		"typecheck": "tsc --noEmit",
		"build:ts": "tsc",
		"build:bundle": "rollup -c rollup.config.mjs",
		"build:bundle:prod": "NODE_ENV=production rollup -c rollup.config.mjs",
		"build:bundle:analyze": "ANALYZE=true rollup -c rollup.config.mjs",
		"build:bundle:small": "PROFILE=small NODE_ENV=production rollup -c rollup.config.mjs",
		"build:bundle:perf": "PROFILE=performance NODE_ENV=production rollup -c rollup.config.mjs",
		"build:lib": "bun run typecheck && bun run build:bundle",
		"build:lib:prod": "bun run typecheck && bun run build:bundle:prod",
		"build:lib:analyze": "bun run build:bundle:analyze",
		"format": "bunx prettier . --write",
		"format:check": "bunx prettier . --write --fix",
		"format:build": "cd build && prettier . --write --fix -c",
		"lint": "eslint lib --ext .ts",
		"lint:fix": "eslint lib --ext .ts --fix",
		"clean-code": "rmcm -l js -i -c 0 -r ./lib --verbose && bun run format",
		"clean-code-all-root": "rmcm -l js -i -r -c 0 ./lib/** && bun run format",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"prepublishOnly": "bun run clean && bun run build:lib:prod",
		"prepare": "husky || true",
		"version:patch": "npm version patch",
		"version:minor": "npm version minor",
		"version:major": "npm version major",
		"release": "bun run prepublishOnly && npm publish",
		"release:dry": "bun run prepublishOnly && npm publish --dry-run",
		"rebuild": "bun run clean && bun run build:lib:prod && bun run format:check",
		"rebuild:fast": "bun run clean && bun run build:lib:prod",
		"deploy-gh-pages": "bun run docs:build && gh-pages -d docs/.vitepress/dist -b gh-pages"
	},
	"dependencies": {
		"axios": "^1.15.0",
		"axios-ntlm": "^1.4.6",
		"httpntlm": "^1.8.13",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@microsoft/tsdoc": "^0.16.0",
		"@microsoft/tsdoc-config": "^0.18.1",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/bun": "^1.3.12",
		"@types/node": "^25.6.0",
		"@typescript-eslint/eslint-plugin": "^8.58.2",
		"@typescript-eslint/parser": "^8.58.2",
		"@vitest/coverage-v8": "^4.1.4",
		"dts-bundle-generator": "^9.5.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"minimatch": "^10.2.5",
		"prettier": "^3.8.3",
		"rollup": "^4.60.1",
		"rollup-plugin-copy": "^3.5.0",
		"rollup-plugin-dts": "^6.4.1",
		"rollup-plugin-filesize": "^10.0.0",
		"rollup-plugin-generate-package-json": "^3.2.0",
		"rollup-plugin-license": "^3.7.1",
		"rollup-plugin-node-externals": "^9.0.1",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-visualizer": "^7.0.1",
		"tough-cookie": "^6.0.1",
		"tsdoc": "^0.0.4",
		"tslib": "^2.8.1",
		"typedoc": "^0.28.19",
		"typedoc-plugin-coverage": "^4.0.3",
		"typedoc-plugin-extras": "^4.0.1",
		"typedoc-plugin-markdown": "^4.11.0",
		"typedoc-plugin-missing-exports": "^4.1.3",
		"typedoc-plugin-rename-defaults": "^0.7.3",
		"typedoc-vitepress-theme": "^1.1.2",
		"typescript": "^6.0.2",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.4"
	}
}
