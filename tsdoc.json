{
	"$schema": "https://developer.microsoft.com/json-schemas/tsdoc/v0/tsdoc.schema.json",
	"tagDefinitions": [
		{ "tagName": "@packageDocumentation", "syntaxKind": "modifier", "allowMultiple": false },
		{ "tagName": "@internal", "syntaxKind": "modifier", "allowMultiple": false },
		{ "tagName": "@beta", "syntaxKind": "modifier", "allowMultiple": false },
		{ "tagName": "@alpha", "syntaxKind": "modifier", "allowMultiple": false },
		{ "tagName": "@experimental", "syntaxKind": "modifier", "allowMultiple": false },
		{ "tagName": "@example", "syntaxKind": "block", "allowMultiple": true },
		{ "tagName": "@since", "syntaxKind": "block", "allowMultiple": false },
		{ "tagName": "@deprecated", "syntaxKind": "block", "allowMultiple": false },
		{ "tagName": "@see", "syntaxKind": "block", "allowMultiple": true },
		{ "tagName": "@throws", "syntaxKind": "block", "allowMultiple": true },
		{ "tagName": "@license", "syntaxKind": "block", "allowMultiple": false }
	],
	"supportForTags": {
		"@remarks": true,
		"@see": true,
		"@defaultValue": true,
		"@throws": true,
		"@param": true,
		"@returns": true,
		"@deprecated": true,
		"@example": true,
		"@since": true,
		"@version": true,
		"@author": true,
		"@license": true
	}
}
